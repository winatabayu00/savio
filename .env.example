# Savio environment template. Copy to .env and adjust.

APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://savio:savio@localhost:5433/savio?sslmode=disable

REDIS_URL=redis://localhost:6380/0

JWT_SECRET=change-me-32-char-minimum-secret-value
CSRF_SECRET=change-me-32-char-minimum-secret-value

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

FRONTEND_ORIGIN=http://localhost:5173

AI_ENABLED=false
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=savio
MINIO_SECRET_KEY=saviosecret
MINIO_BUCKET=savio-files